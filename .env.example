# ═══════════════════════════════════════════════
# MCPHub 部署环境变量
# 复制本文件为 .env 并填写实际值：cp .env.example .env
# ═══════════════════════════════════════════════

# ─────────────────────────────────────────────
# MCPHub 本身
# ─────────────────────────────────────────────
# 管理面板端口
MCPHUB_PORT=3000
# 首次启动的管理员密码
ADMIN_PASSWORD=mcphub2024

# ─────────────────────────────────────────────
# PostgreSQL 数据库
# ─────────────────────────────────────────────
DB_PASSWORD=mcphub_password
DB_PORT=5432

# ─────────────────────────────────────────────
# 鼎捷 ERP 互联中台（必填）
# ─────────────────────────────────────────────
DINGJIE_SERVER_URL=https://erp.company.com/
DINGJIE_KEY=f5458f5c0f9022db743a7c0710145903
DINGJIE_ENT_ID=99
DINGJIE_COMPANY_ID=DSCTC

# 鼎捷可选
# DINGJIE_TARGET_PROD=E10        # 接收方产品：T100/E10/TIPTOP/易飞
# DINGJIE_LANG=zh_CN             # 语言：zh_TW/zh_CN
# DINGJIE_TIMEOUT=30             # 请求超时（秒）
# DINGJIE_VERIFY_SSL=1           # 是否验证 SSL

# ─────────────────────────────────────────────
# 金蝶云星空 K3Cloud（必填）
# ─────────────────────────────────────────────
KD_ACCT_ID=your_acct_id
KD_USERNAME=your_username
KD_APP_ID=your_app_id
KD_APP_SEC=your_app_secret
KD_SERVER_URL=https://your-server/k3cloud/
KD_LCID=2052
KD_ORG_NUM=

# ─────────────────────────────────────────────
# Odoo（通过配置文件，不用环境变量）
# 复制 mcp-servers/mcp-odoo/odoo_config.json.example
# 为 mcp-servers/mcp-odoo/odoo_config.json 并填写
# ─────────────────────────────────────────────
# ODOO_CONFIG_PATH=/app/mcp-servers/mcp-odoo/odoo_config.json

# ─────────────────────────────────────────────
# 通用 MCP 设置
# ─────────────────────────────────────────────
# 模式：readonly（仅查询）/ readwrite（全部操作，默认）
# MCP_MODE=readwrite
