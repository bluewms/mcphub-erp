# === 必填 ===
# 鼎捷 ERP 互联中台服务器地址
DINGJIE_SERVER_URL=https://erp.company.com/
# 互联中台 API Key
DINGJIE_KEY=f5458f5c0f9022db743a7c0710145903
# 企业编号
DINGJIE_ENT_ID=99
# 营运据点
DINGJIE_COMPANY_ID=DSCTC

# === 可选 ===
# 接收方产品（T100/E10/TIPTOP/易飞），默认 E10
# DINGJIE_TARGET_PROD=E10
# 接收方数据库 ID
# DINGJIE_TARGET_ID=topprd
# 发送方产品名称，默认 APP
# DINGJIE_HOST_PROD=APP
# 发送方 IP 地址
# DINGJIE_HOST_IP=10.40.71.91
# 语言（zh_TW/zh_CN）
# DINGJIE_LANG=zh_TW
# 请求超时（秒）
# DINGJIE_TIMEOUT=30
# 是否验证 SSL
# DINGJIE_VERIFY_SSL=1

# === MCP 配置 ===
# 模式 (readonly/readwrite)
# MCP_MODE=readwrite
# SSE/HTTP 模式 API Key
# MCP_API_KEY=
# 日志级别
# MCP_LOG_LEVEL=INFO